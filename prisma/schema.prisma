generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Lifecycle {
  IDEA
  BUILDING
  TESTING
  RELEASED
  ARCHIVED
}

enum TagKind {
  TECHNOLOGY
  TOPIC
}

enum AssetUsage {
  COVER
  INLINE
  ATTACHMENT
}

// Identity only; authentication provider/session tables belong to phase 2.
model User {
  id              String    @id @default(uuid()) @db.Uuid
  displayName     String    @db.VarChar(100)
  createdAt       DateTime  @default(now()) @db.Timestamptz(6)
  createdProjects Project[] @relation("ProjectCreator")
  updatedProjects Project[] @relation("ProjectUpdater")
  assets          Asset[]
  createdInquiries Inquiry[] @relation("InquiryCreator")
  updatedInquiries Inquiry[] @relation("InquiryUpdater")
}

model AuthUser {
  id            String @id
  name          String
  email         String @unique
  emailVerified Boolean @default(false)
  image         String?
  createdAt     DateTime @default(now()) @db.Timestamptz(6)
  updatedAt     DateTime @db.Timestamptz(6)
  sessions      AuthSession[]
  accounts      AuthAccount[]
}

model AuthSession {
  id        String @id
  userId    String
  token     String @unique
  expiresAt DateTime @db.Timestamptz(6)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @db.Timestamptz(6)
  user      AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@index([userId])
}

model AuthAccount {
  id                    String @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime? @db.Timestamptz(6)
  refreshTokenExpiresAt DateTime? @db.Timestamptz(6)
  scope                 String?
  password              String?
  createdAt             DateTime @default(now()) @db.Timestamptz(6)
  updatedAt             DateTime @db.Timestamptz(6)
  user                  AuthUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  @@unique([providerId, accountId])
  @@index([userId])
}

model AuthVerification {
  id         String @id
  identifier String
  value      String
  expiresAt  DateTime @db.Timestamptz(6)
  createdAt  DateTime @default(now()) @db.Timestamptz(6)
  updatedAt  DateTime @db.Timestamptz(6)
  @@index([identifier])
}

model CommonCodeGroup {
  key         String       @id @db.VarChar(60)
  nameKo      String       @db.VarChar(100)
  nameEn      String       @db.VarChar(100)
  description String       @default("")
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now()) @db.Timestamptz(6)
  updatedAt   DateTime     @updatedAt @db.Timestamptz(6)
  codes       CommonCode[]
}

model CommonCode {
  groupKey  String          @db.VarChar(60)
  code      String          @db.VarChar(60)
  nameKo    String          @db.VarChar(100)
  nameEn    String          @db.VarChar(100)
  position  Int             @default(0)
  isActive  Boolean         @default(true)
  createdAt DateTime        @default(now()) @db.Timestamptz(6)
  updatedAt DateTime        @updatedAt @db.Timestamptz(6)
  group     CommonCodeGroup @relation(fields: [groupKey], references: [key], onDelete: Restrict)
  origins   Project[]       @relation("ProjectOrigin")
  types     Project[]       @relation("ProjectType")
  inquiryTypes Inquiry[]    @relation("InquiryType")
  inquiryStatuses Inquiry[] @relation("InquiryStatus")
  postCategories Post[] @relation("PostCategory")

  @@id([groupKey, code])
}

model Inquiry {
  id String @id @default(uuid()) @db.Uuid
  typeGroup String @default("INQUIRY_TYPE") @db.VarChar(60)
  typeCode String @db.VarChar(60)
  statusGroup String @default("INQUIRY_STATUS") @db.VarChar(60)
  statusCode String @default("PENDING") @db.VarChar(60)
  body String @db.VarChar(4000)
  createdById String? @db.Uuid
  updatedById String? @db.Uuid
  createdAt DateTime @default(now()) @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @db.Timestamptz(6)
  type CommonCode @relation("InquiryType", fields: [typeGroup, typeCode], references: [groupKey, code], onDelete: Restrict)
  status CommonCode @relation("InquiryStatus", fields: [statusGroup, statusCode], references: [groupKey, code], onDelete: Restrict)
  createdBy User? @relation("InquiryCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy User? @relation("InquiryUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  @@index([statusGroup, statusCode, createdAt])
  @@index([typeGroup, typeCode])
}

model Project {
  customerName String               @default("") @db.VarChar(200)
  deletedAt    DateTime?            @db.Timestamptz(6)
  id           String               @id @default(uuid()) @db.Uuid
  slug         String               @unique @db.VarChar(80)
  originGroup  String               @default("PROJECT_ORIGIN") @db.VarChar(60)
  originCode   String               @db.VarChar(60)
  typeGroup    String               @default("PROJECT_TYPE") @db.VarChar(60)
  typeCode     String?              @default("UNSPECIFIED") @db.VarChar(60)
  lifecycle    Lifecycle?
  isVisible    Boolean              @default(false)
  thumbnailUrl String?              @db.VarChar(2048)
  placeholder  Boolean              @default(false)
  startedOn    DateTime?            @db.Date
  endedOn      DateTime?            @db.Date
  createdById  String?              @db.Uuid
  updatedById  String?              @db.Uuid
  createdAt    DateTime             @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime             @updatedAt @db.Timestamptz(6)
  version      Int                  @default(1)
  origin       CommonCode           @relation("ProjectOrigin", fields: [originGroup, originCode], references: [groupKey, code], onDelete: Restrict)
  type         CommonCode?          @relation("ProjectType", fields: [typeGroup, typeCode], references: [groupKey, code], onDelete: Restrict)
  createdBy    User?                @relation("ProjectCreator", fields: [createdById], references: [id], onDelete: Restrict)
  updatedBy    User?                @relation("ProjectUpdater", fields: [updatedById], references: [id], onDelete: Restrict)
  translations ProjectTranslation[]
  tags         ProjectTag[]
  assets       ProjectAsset[]

  @@index([isVisible])
  @@index([originGroup, originCode])
  @@index([typeGroup, typeCode])
}

model Tag {
  id       String       @id @default(uuid()) @db.Uuid
  kind     TagKind
  slug     String       @db.VarChar(80)
  name     String       @db.VarChar(100)
  projects ProjectTag[]

  @@unique([kind, slug])
}

model ProjectTag {
  projectId String  @db.Uuid
  tagId     String  @db.Uuid
  position  Int     @default(0)
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  tag       Tag     @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([projectId, tagId])
  @@index([tagId])
}

model Asset {
  id           String         @id @default(uuid()) @db.Uuid
  storageKey   String         @unique
  originalName String         @db.VarChar(255)
  mimeType     String         @db.VarChar(127)
  byteSize     BigInt
  width        Int?
  height       Int?
  uploadedById String?        @db.Uuid
  createdAt    DateTime       @default(now()) @db.Timestamptz(6)
  uploadedBy   User?          @relation(fields: [uploadedById], references: [id], onDelete: Restrict)
  projects     ProjectAsset[]
  posts        PostAsset[]
}

model ProjectAsset {
  id        String     @id @default(uuid()) @db.Uuid
  projectId String     @db.Uuid
  assetId   String     @db.Uuid
  usage     AssetUsage
  position  Int        @default(0)
  label     String?    @db.VarChar(255)
  project   Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  asset     Asset      @relation(fields: [assetId], references: [id], onDelete: Restrict)

  @@unique([projectId, assetId, usage])
  @@index([assetId])
}

model ProjectTranslation {
  projectId         String  @db.Uuid
  locale            String  @db.VarChar(2)
  title             String  @db.VarChar(200)
  summary           String  @default("")
  body              Json    @db.JsonB
  bodySchemaVersion Int     @default(1)
  project           Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@id([projectId, locale])
}

model Post {
  id           String @id @default(uuid()) @db.Uuid
  slug         String @unique @db.VarChar(80)
  category     String @db.VarChar(40)
  categoryGroup String @default("POST_CATEGORY") @db.VarChar(60)
  categoryCode CommonCode @relation("PostCategory", fields: [categoryGroup, category], references: [groupKey, code], onDelete: Restrict)
  isVisible    Boolean @default(false)
  createdAt    DateTime @default(now()) @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @db.Timestamptz(6)
  deletedAt    DateTime? @db.Timestamptz(6)
  version      Int @default(1)
  translations PostTranslation[]
  assets       PostAsset[]
  @@index([isVisible, createdAt])
  @@index([categoryGroup, category])
}

model PostTranslation {
  postId String @db.Uuid
  locale String @db.VarChar(2)
  title String @db.VarChar(200)
  summary String @default("")
  body Json @db.JsonB
  bodySchemaVersion Int @default(1)
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  @@id([postId, locale])
}

model PostAsset {
  postId String @db.Uuid
  assetId String @db.Uuid
  post Post @relation(fields: [postId], references: [id], onDelete: Cascade)
  asset Asset @relation(fields: [assetId], references: [id], onDelete: Restrict)
  @@id([postId, assetId])
  @@index([assetId])
}
