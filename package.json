    "db:generate": "prisma generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:migrate:deploy": "prisma migrate deploy",
    "db:seed": "node scripts/seed.mjs",
    "db:test": "node scripts/check-database.mjs"
  },
  "dependencies": {
    "@mantine/core": "9.7.1",
    "@mantine/hooks": "9.7.1",
