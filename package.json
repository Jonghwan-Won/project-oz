    "@tiptap/extension-image": "3.32.0",
    "@tiptap/extension-table": "3.32.0",
    "@tiptap/pm": "3.32.0",
    "@tiptap/react": "3.32.0",
    "@tiptap/starter-kit": "3.32.0",
    "@tiptap/static-renderer": "3.32.0",
    "better-auth": "1.7.14",
    "lenis": "1.3.27",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
